---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AsciiWord from "../components/AsciiWord.astro";
import Bars from "../components/charts/Bars.astro";
import wombatArt from "../data/wombat.txt?raw";
import { eighteenTask, seconds } from "../data/benchmarks";

const lean = eighteenTask.rows[2];
const pi = eighteenTask.rows[0];
const speedup = (pi.seconds / lean.seconds).toFixed(2);

const speedRows = [
  {
    label: "Wombat",
    sub: "lean profile",
    bars: [{ tone: "wombat" as const, value: lean.seconds, display: seconds(lean.seconds) }],
  },
  {
    label: "Pi 1.4.0",
    sub: "default profile",
    bars: [{ tone: "pi" as const, value: pi.seconds, display: seconds(pi.seconds) }],
  },
];

const features = [
  {
    title: "One binary, no runtime",
    body: "Go builds it; the terminal runs it. Classic TUI out of the box, an optional opentui interface when you want the framed inspector and live preview.",
  },
  {
    title: "Nine tools by default",
    body: "The coding profile exposes read, write, edit, bash, glob, grep, apply_patch, tool_search and request_capability. Web, LSP, verify and media load mid-run when the task needs them.",
  },
  {
    title: "Research with a budget",
    body: "Quick gives 2 searches and 1 fetch, standard 5 and 3, deep 10 and 6 — each with a hard ceiling. When the budget is spent the model is told to synthesize, not to keep looping.",
  },
  {
    title: "A fleet when you ask",
    body: "Plan a ledger, run scouts and writers in isolated git worktrees, pass reports down the dependency graph, and merge only what passes its checks.",
  },
  {
    title: "Sessions and checkpoints",
    body: "JSONL transcripts per project, resume by id or last, and shadow-git snapshots so a bad edit is one command from gone.",
  },
  {
    title: "MCP, skills, custom agents",
    body: "stdio and HTTP servers with OAuth and per-server gates, skills as markdown, and specialists with their own prompt, tools, permissions and model.",
  },
];

const docsCards = [
  {
    href: "/docs/getting-started",
    n: "01",
    title: "Getting started",
    body: "Install, choose a provider, build the optional UI, and run a first task.",
  },
  {
    href: "/docs/tools",
    n: "02",
    title: "Tools & profiles",
    body: "The nine-tool coding profile, capability loading, and research budgets.",
  },
  {
    href: "/docs/agents",
    n: "03",
    title: "Agents & orchestration",
    body: "Custom agents, the plan scheduler, worktrees and review policy.",
  },
  {
    href: "/compare",
    n: "04",
    title: "Wombat vs Pi",
    body: "The benchmarks, the method, the caveats, and the raw data path.",
  },
];
---

<Base
  title="Wombat — a general-purpose agent in your terminal"
  description="Wombat is a general-purpose terminal agent: nine tools by default, capabilities on demand, bounded research, a parallel worker fleet, MCP servers and custom agents. Benchmarked faster than Pi on the 18-task suite."
>
  <a class="skip" href="#main">Skip to content</a>
  <Header active="home" />

  <main id="main">
    <section class="hero hero--home wrap">
      <div class="hero__grid">
        <figure class="art">
          <pre aria-hidden="true">{wombatArt}</pre>
          <figcaption>general purpose, terminal native</figcaption>
        </figure>

        <div class="hero__copy">
          <h1 class="wordmark">
            <span class="sr-only">Wombat</span>
            <AsciiWord class="wordmark__art" text="wombat" />
          </h1>
          <p class="tagline">A general-purpose agent. In your terminal. Finishes the job.</p>
          <p class="lede">
            Edit, run, verify, browse and research with one binary that keeps its tool registry
            small and its research bounded — then hands back when the work is done, not when it
            runs out of ideas.
          </p>

          <div class="cmd">
            <span class="cmd__sigil" aria-hidden="true">$</span>
            <code id="install-one">curl -fsSL https://raw.githubusercontent.com/ramsterr/Wombat/main/install.sh | bash</code>
            <button class="copy" type="button" data-copy="install-one">copy</button>
          </div>

          <div class="hero-claims">
            <span class="claim"><i></i>18/18 tasks passed</span>
            <span class="claim"><i></i>{speedup}× faster than Pi on the suite</span>
            <span class="claim"><i></i>41% fewer prompt tokens</span>
          </div>

          <div class="actions">
            <a class="btn btn--solid" href="/docs/getting-started">Install Wombat</a>
            <a class="btn" href="/compare">Read the benchmarks</a>
            <a class="btn" href="/docs">Documentation</a>
          </div>

          <dl class="meta">
            <div><dt>release</dt><dd>v0.2.6</dd></div>
            <div><dt>main</dt><dd>ahead of the tag</dd></div>
            <div><dt>build</dt><dd>Go 1.26.3+</dd></div>
            <div><dt>license</dt><dd>MIT</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="band" id="speed">
      <div class="band__grid wrap">
        <div>
          <p class="eyebrow">benchmarks</p>
          <h2>Faster than Pi across a full suite, and cheaper on tokens.</h2>
          <div class="band__big">
            <span class="band__n">{speedup}×</span>
            <span class="band__k">faster total wall time<br />133.6s vs 270.2s, 18 tasks</span>
          </div>
          <p class="band__note">
            Same model, same tasks, same skill and MCP server, fresh workspace per run. Wombat
            passes 18/18 with the lean profile, uses 41% fewer prompt tokens, and finishes the
            research task Pi times out on. The comparison page also shows where Pi is still the
            lighter harness — small, single-file work.
          </p>
          <div class="band__links">
            <a class="btn" href="/compare">Full comparison</a>
            <a class="btn" href="/docs/tools">How the tool budget works</a>
          </div>
        </div>

        <Bars
          rows={speedRows}
          max={300}
          labelWidth={104}
          compact={true}
          showLegend={false}
          tickCount={3}
          caption="Total wall time, 18-task suite: Pi 1.4.0 vs Wombat's lean profile."
        />
      </div>
    </section>

    <section class="sec wrap" id="features">
      <div class="sec__head">
        <h2>The parts that make it different</h2>
        <p class="sec__note">
          Not a feature list for its own sake: each of these changes how a run behaves, and each
          one is documented with the exact commands in
          <a href="/docs">the docs</a>.
        </p>
      </div>

      <div class="features">
        {features.map((feature) => (
          <article>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sec wrap" id="start">
      <div class="split">
        <div class="prose">
          <p class="eyebrow">quick start</p>
          <h2 style="font-size: clamp(1.25rem, 2.4vw, 1.7rem); letter-spacing: -0.04em;">
            From clone to first task in two commands.
          </h2>
          <p style="margin-top: 16px;">
            The installer gives you the latest tagged release. If you want the capability profiles,
            research budgets and custom agents described on this site, install from
            <code>main</code> — the tag is behind the branch.
          </p>

          <div class="codewrap">
            <pre><code id="quickstart"># current main
go install github.com/ramsterr/Wombat/cmd/wombat@main

wombat setup     # provider, key, model
wombat doctor    # one small request, errors surfaced
wombat           # open the chat

# or the tagged release
curl -fsSL https://raw.githubusercontent.com/ramsterr/Wombat/main/install.sh | bash</code></pre>
            <button class="copy" type="button" data-copy="quickstart">copy</button>
          </div>

          <div class="note">
            <strong>Optional opentui interface.</strong> <code>cd tui &amp;&amp; npm install &amp;&amp; npm run build</code>
            once (Node 26.4+), then run Wombat from that checkout. Without it you get the classic
            TUI, which has every feature except the rendering. Switch back with
            <code>wombat classic</code>.
          </div>
        </div>

        <dl class="spec">
          <div><dt>runtime</dt><dd>none — one static Go binary</dd></div>
          <div><dt>providers</dt><dd>OpenAI-compatible, Anthropic, OpenCode, local servers</dd></div>
          <div><dt>default profile</dt><dd>9 tools, capabilities on demand</dd></div>
          <div><dt>research</dt><dd>off · quick · standard · deep, with hard ceilings</dd></div>
          <div><dt>fleet</dt><dd>5 scouts · 2 writers · git worktrees</dd></div>
          <div><dt>state</dt><dd>~/.wombat — config, sessions, checkpoints, agents</dd></div>
        </dl>
      </div>
    </section>

    <section class="sec wrap" id="fleet">
      <div class="sec__head">
        <h2>A fleet, only when the work is parallel</h2>
        <p class="sec__note">
          The lead plans, workers execute, checks decide. Nothing about the fleet is implicit: a
          one-step plan is a single agent.
        </p>
      </div>

      <div class="features">
        <article>
          <h3>Dependency graph, not rounds</h3>
          <p>Free slots start newly-ready work, long chains are scheduled first, and a slow scout never holds up an independent writer.</p>
        </article>
        <article>
          <h3>Owned files</h3>
          <p>Writers declare the files they may change. Writes outside that set are refused, which is what makes automatic merges safe.</p>
        </article>
        <article>
          <h3>Worktrees and checks</h3>
          <p>Work happens in a git worktree; checks run once, review policy decides who reads the patch, and the merge is three-way.</p>
        </article>
        <article>
          <h3>Resumable workers</h3>
          <p>A worker that needs a decision returns <code>needs_input</code>; <code>resume_worker</code> continues the same session and worktree.</p>
        </article>
      </div>
    </section>

    <section class="sec wrap" id="docs">
      <div class="sec__head">
        <h2>Documentation</h2>
        <p class="sec__note">
          Eight guides, matched to <code>main</code> after v0.2.6, with the exact commands quoted
          from the repository.
        </p>
      </div>

      <div class="guides">
        {docsCards.map((card) => (
          <a class="guide" href={card.href}>
            <span class="guide__n">{card.n}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <span class="guide__go">open →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="sec cta wrap" id="cta">
      <div class="cta__in">
        <div>
          <p class="eyebrow">install</p>
          <p class="cta__line">One binary. One config file. Start with the docs, then decide about the fleet.</p>
        </div>
        <div class="cta__links">
          <a class="btn btn--solid" href="/docs/getting-started">Get started</a>
          <a class="btn" href="https://github.com/ramsterr/Wombat" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    document.querySelectorAll<HTMLButtonElement>(".copy").forEach((button) => {
      button.addEventListener("click", async () => {
        const target = document.getElementById(button.dataset.copy ?? "");
        if (!target) return;
        const text = target.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const field = document.createElement("textarea");
          field.value = text;
          field.setAttribute("readonly", "");
          field.style.position = "fixed";
          field.style.opacity = "0";
          document.body.appendChild(field);
          field.select();
          document.execCommand("copy");
          field.remove();
        }
        button.textContent = "copied";
        button.dataset.done = "true";
        window.setTimeout(() => {
          button.textContent = "copy";
          delete button.dataset.done;
        }, 1600);
      });
    });
  </script>
</Base>
